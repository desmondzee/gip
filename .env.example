MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=persona

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_BASELINE_MODEL=gemini-2.5-pro

COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Persona identity (used to tag user-authored memories at ingest)
PERSONA_USER_NAME=Jerry
PERSONA_USER_EMAIL=
# Comma-separated email aliases (plus-addresses, work account, etc.)
PERSONA_USER_EMAILS=
# Notion: API user UUID (from /v1/users/me)
PERSONA_NOTION_USER_ID=
# GitHub: case-sensitive login
PERSONA_GITHUB_LOGIN=

# Voice generation layer (optional — when configured, summarize_for_answer routes
# through a separate model that rewrites the answer with retrieved voice exemplars).
# PERSONA_VOICER picks the backend:
#   off       — passthrough; Claude's draft is the final answer
#   gemini    — in-context voicing via Gemini (cheap; uses GEMINI_API_KEY)
#   together  — learned-weights voicing via Together AI LoRA adapter
PERSONA_VOICER=off

# Gemini voicer (when PERSONA_VOICER=gemini)
# Falls back to GEMINI_BASELINE_MODEL, then to gemini-2.5-flash, when unset.
GEMINI_VOICER_MODEL=gemini-2.5-flash

# Together AI voicer (when PERSONA_VOICER=together)
TOGETHER_API_KEY=
# Together AI fine-tuned model id (e.g., username/llama-3.1-8b-instruct-jerry-v1-lora)
PERSONA_LORA_ADAPTER=
